# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── PostgreSQL (docker compose) ──────────────────────────────────────────────
POSTGRES_USER=codequest
POSTGRES_PASSWORD=codequest
POSTGRES_DB=codequest
DATABASE_URL=postgresql://codequest:codequest@localhost:15432/codequest?schema=public

# ── Redis (docker compose) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ── MinIO (docker compose) ───────────────────────────────────────────────────
MINIO_ROOT_USER=codequest
MINIO_ROOT_PASSWORD=codequest123
MINIO_ENDPOINT=localhost:59000
MINIO_BUCKET=codequest

# ── Mail (MailHog, docker compose) ───────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@codequest.local
WEB_APP_URL=http://localhost:5173

# ── Runner ───────────────────────────────────────────────────────────────────
RUNNER_PORT=4000
RUNNER_TIMEOUT_MS=5000
RUNNER_MEMORY_LIMIT=256m
RUNNER_CPU_LIMIT=0.5
